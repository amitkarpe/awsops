# Owner-local values. Copy outside the public awsops checkout before editing.
# These are key/schema examples only; never commit populated credentials.
HOST=127.0.0.1
PORT=4311
MONGO_URI=mongodb://127.0.0.1:27111/LibreChat
DOMAIN_CLIENT=http://127.0.0.1:4311
DOMAIN_SERVER=http://127.0.0.1:4311

AWSOPS_HOME_REPO=<ABSOLUTE_PATH_TO_AWSOPS_CHECKOUT>
AWSOPS_HOME_PYTHON=<ABSOLUTE_PATH_TO_AWSOPS_VENV_PYTHON>
AWSOPS_CONFIG_BACKEND_URL=http://127.0.0.1:4313
COMPLIANCE_AGENT_V1_HARNESS_ARN=<PRIVATE_EXISTING_HARNESS_ARN>

AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1
AWS_PROFILE=<OWNER_SSO_PROFILE>
AWS_SDK_LOAD_CONFIG=1

# LibreChat's Bedrock endpoint uses its own profile variable.
BEDROCK_AWS_DEFAULT_REGION=ap-southeast-1
BEDROCK_AWS_PROFILE=<OWNER_SSO_PROFILE>
BEDROCK_AWS_MODELS=global.amazon.nova-2-lite-v1:0
