# Service-level values only. LibreChat application secrets remain in its private .env.
HOME=/opt/awsops-native-canary/state/home
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=512
DOMAIN_CLIENT=https://sec2.astromedicomp.org
DOMAIN_SERVER=https://sec2.astromedicomp.org
PORT=4311

# Deferred Issue #11 only; leave unset for the read-only Home demo.
# AWSOPS_NATIVE_CONFIG=/opt/awsops-native-canary/state/native.json
# AWSOPS_READ_CONFIG=/opt/awsops-native-canary/state/read.json
# AWSOPS_SDK_HOME=/home/ssm-user
